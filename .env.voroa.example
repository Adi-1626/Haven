# ==============================================================================
# Haven Backend — Voroa Production Environment Template
# Deployed Service: https://haven-backend.getvoroa.com/
#
# Configure these variables in Voroa Dashboard -> Project Settings -> Environment Variables.
# NEVER commit real credentials to version control.
# Production secrets must be configured via the Voroa dashboard.
# ==============================================================================

HAVEN_MODE=hosted
NODE_ENV=production
HOST=0.0.0.0

# Port: Leave empty or omit in Voroa dashboard; Voroa assigns $PORT dynamically.
# If running locally or requiring a manual fallback: PORT=3001
# PORT=3001

# Static file serving: Set to false (frontend is hosted separately on Cloudflare Pages)
SERVE_STATIC=false

# Reverse proxy and secure cookie settings behind Voroa's TLS terminator
TRUST_PROXY=1
SECURE_COOKIES=1

# ==============================================================================
# Frontend Origin & CORS Settings
# ==============================================================================
# Set to your Cloudflare Pages production URL once created (e.g. https://<project>.pages.dev)
PUBLIC_URL=https://<your-cloudflare-pages-project>.pages.dev

# Comma-separated list of allowed origins for REST CORS and Socket.IO handshakes
# Include your Cloudflare Pages domain and any custom domain
ALLOWED_ORIGINS=https://<your-cloudflare-pages-project>.pages.dev

# ==============================================================================
# Supabase Mumbai ap-south-1 Configuration (Project: tswmpzeckmquvrlzvtsy)
# ==============================================================================
SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co

# Publishable / Anon key used by the backend to verify Supabase JWTs and auth tokens
# Obtain from: Supabase Dashboard -> Project Settings -> API Keys -> anon (public)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# PostgreSQL connection string via Supabase Connection Pooler (Port 6543)
# Replace [YOUR-PASSWORD] with the haven_app database user password
DATABASE_URL=postgres://haven_app.tswmpzeckmquvrlzvtsy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Secret service_role key for backend storage management (attachments, server icons)
# Obtain from: Supabase Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ==============================================================================
# WebRTC STUN/TURN Configuration
# ==============================================================================
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# TURN relay (Turnix.io, project haven-voice) — needed by users behind symmetric NAT / strict firewalls, whose
# voice otherwise never connects. Hosted Mode only. Turnix Console -> haven-voice -> API Tokens -> Create.
# Set the token ONLY in the Voroa environment: never in this file, Git or browser code. The backend mints a
# per-user 12h credential from it (reused for 1h); clients never see the token. Unset = STUN only.
# TURNIX_API_TOKEN=
# Leave both region settings unset: Turnix then selects the relay region itself (any region the plan allows).
# Optional overrides, a slug from Turnix GET /regions: PREFERRED falls back if unavailable, FIXED fails instead.
# TURNIX_PREFERRED_REGION=
# TURNIX_FIXED_REGION=
# Usage is tagged per user (initiator_client = u_ pseudonym) in the Turnix Console; set DIAGNOSTICS_SALT below.

# ==============================================================================
# Diagnostics (structured JSON lines in Voroa runtime logs)
# ==============================================================================
# HAVEN_LOG_LEVEL=info
# Keys the u_/s_ pseudonyms so they stay stable across restarts; any long random string.
# DIAGNOSTICS_SALT=
