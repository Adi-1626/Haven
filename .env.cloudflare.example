# ==============================================================================
# Haven Frontend — Cloudflare Pages Production Environment Template
#
# Configure these variables in Cloudflare Pages Dashboard -> Settings -> Environment Variables.
# These variables are baked into the Vite client build bundle.
# Use ONLY public/publishable keys here. NEVER add secret keys or database passwords.
# ==============================================================================

# Node.js version for Cloudflare Pages build environment
NODE_VERSION=22

# Voroa production backend URL (REST API & Socket.IO endpoint)
VITE_API_URL=https://haven-backend.getvoroa.com

# Supabase Mumbai Project URL & Publishable Anon Key (Safe for browser consumption)
VITE_SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
