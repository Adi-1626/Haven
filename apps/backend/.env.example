# Haven Backend Environment Configuration (Voroa / Production Template)
# Configure these variables in Voroa Dashboard -> Project Settings -> Environment Variables.

HAVEN_MODE=hosted
NODE_ENV=production
HOST=0.0.0.0
# PORT=3001 # Leave empty in Voroa; platform assigns $PORT automatically

# Static files: disabled in cloud production; web is hosted on Cloudflare Pages
SERVE_STATIC=false

# Reverse proxy and secure cookie settings behind TLS
TRUST_PROXY=1
SECURE_COOKIES=1

# Public HTTPS URL of the hosted web app (Cloudflare Pages or custom domain)
PUBLIC_URL=https://<your-cloudflare-pages-project>.pages.dev

# Allowed frontend origins for CORS and Socket.IO (comma-separated)
ALLOWED_ORIGINS=https://<your-cloudflare-pages-project>.pages.dev

# Supabase Mumbai ap-south-1 Configuration (Project: tswmpzeckmquvrlzvtsy)
SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
DATABASE_URL=postgres://haven_app.tswmpzeckmquvrlzvtsy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# WebRTC STUN/TURN configuration
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
