# Haven Backend Environment Configuration (Voroa / Local)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=/data

# Public HTTPS URL of the hosted web app (Cloudflare Pages or custom domain)
PUBLIC_URL=https://haven.pages.dev

# Allowed frontend origins for CORS and Socket.IO (comma-separated)
ALLOWED_ORIGINS=https://haven.pages.dev,http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy and secure cookie settings
TRUST_PROXY=1
SECURE_COOKIES=1
COOKIE_SAMESITE=none
CROSS_SITE_COOKIES=true

# Static files (disabled by default in cloud production; web is hosted on Cloudflare Pages)
SERVE_STATIC=false

# WebRTC STUN/TURN configuration
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
