# Haven Hosted Mode Configuration Template
# To use: Copy this file to .env.hosted and fill in your Supabase credentials.
# Then launch with: npm run dev:hosted (for web) or npm run desktop:hosted (for desktop)

HAVEN_MODE=hosted
PORT=3001
HOST=127.0.0.1

# ==============================================================================
# Supabase Project Configuration (Project: tswmpzeckmquvrlzvtsy)
# ==============================================================================
# Project URL:
SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co
VITE_SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co

# Publishable / Anon Client Key (Safe for frontend consumption via /api/config or client env):
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ==============================================================================
# Server-Only Backend Credentials (NEVER expose to frontend / Vite / clients)
# ==============================================================================
# 1. PostgreSQL Connection URL:
# Connects backend to Supabase PostgreSQL database via connection pooler (Port 6543):
# Replace [YOUR-PASSWORD] with the haven_app service password:
DATABASE_URL=postgres://haven_app.tswmpzeckmquvrlzvtsy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Supabase Service Role Secret:
# Required by backend for private storage bucket operations (attachments, avatars, etc.)
# and administrative token checks.
# Obtain from: Supabase Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ==============================================================================
# Optional Public URL
# ==============================================================================
# Reachable origin for password reset redirects & invitation links:
# PUBLIC_URL=http://localhost:5173
