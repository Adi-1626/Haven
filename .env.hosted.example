# ==============================================================================
# Haven Local Hosted Mode Configuration Template
# Used exclusively for local Hosted Mode development (Electron desktop or local web against Supabase Mumbai).
#
# To use: Copy this file to .env.hosted and fill in your Supabase credentials.
# Then launch with:
#   - npm run dev:hosted      (Local web client + local hosted Express backend)
#   - npm run desktop:hosted  (Local Electron desktop client with isolated .hosted-profile)
# ==============================================================================

HAVEN_MODE=hosted
PORT=3001
HOST=127.0.0.1

# ==============================================================================
# Supabase Project Configuration (Project: tswmpzeckmquvrlzvtsy)
# ==============================================================================
SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co
VITE_SUPABASE_URL=https://tswmpzeckmquvrlzvtsy.supabase.co

# Publishable / Anon Client Key (Safe for client-side consumption):
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ==============================================================================
# Server-Only Backend Credentials (NEVER expose to frontend / Vite client bundles)
# ==============================================================================
# 1. PostgreSQL Connection URL:
# Connects backend to Supabase PostgreSQL database via connection pooler (Port 6543):
# Replace [YOUR-PASSWORD] with your real database password:
DATABASE_URL=postgres://haven_app.tswmpzeckmquvrlzvtsy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Supabase Service Role Secret:
# Required by backend for private storage bucket operations (attachments, server icons)
# and administrative token checks.
# Obtain from: Supabase Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
