PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Reachable HTTPS origin used in invitation links (omit for same-PC localhost testing):
# PUBLIC_URL=https://haven.example.com
# For a trusted local HTTPS reverse proxy only:
# TRUST_PROXY=1
# SECURE_COOKIES=1
# ALLOWED_ORIGINS=https://haven.example.com
# HTTPS reverse proxy required for remote browser microphone and screen capture.
# Configure your own TURN for peers behind restrictive NATs:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
